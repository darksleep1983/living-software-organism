{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lso:product-config:1",
  "title": "Living Software Organism product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "adapter", "runtime"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "adapter": {"const": "project-corpus-v2"},
    "runtime": {"const": ".lso-runtime"},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "class", "required"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              "class": {"enum": ["source/git", "runtime/toolchain", "package-lockfile", "environment-presence", "external-service", "durable-data"]},
              "required": {"type": "boolean"},
              "note": {"type": "string", "maxLength": 512},
              "path": {"type": "string", "maxLength": 1023, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[:\\\\])[^/]+(?:/[^/]+)*$"},
              "constraint": {"type": "string", "maxLength": 256}
            }
          }
        },
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "remote", "commit", "files"],
          "properties": {
            "type": {"const": "git"},
            "remote": {"type": "string", "maxLength": 2048},
            "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "files": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "maxLength": 1023}}
          }
        }
      }
    }
  }
}
